# Present.ai frontend configuration (copy to .env.local for local dev, or set in Vercel)

# URL of the Present.ai / Presenton FastAPI backend that the interface talks to.
# Leave empty when running the full stack via Docker (nginx routes /api on the same origin).
# On Vercel, set this to your hosted backend, e.g. https://api.your-domain.com
NEXT_PUBLIC_FAST_API=
# Server-side override used by Next.js route rewrites (defaults to NEXT_PUBLIC_FAST_API).
FAST_API_INTERNAL_URL=

# Set to true to skip the login gate (single-user / desktop style deployments only).
DISABLE_AUTH=
